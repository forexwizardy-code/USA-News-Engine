---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, LATEST } from '../consts';
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for could not be found."
  canonicalPath="/404/"
  noindex
>
  <div class="container notfound">
    <p class="notfound-code">404</p>
    <h1 class="notfound-title">This page could not be found</h1>
    <p class="notfound-text">
      The story may have moved, expired, or never existed. Try one of our sections
      below.
    </p>
    <ul class="notfound-links">
      <li><a href="/">Home</a></li>
      {CATEGORIES.map((c) => (
        <li><a href={`/${c.slug}/`}>{c.label}</a></li>
      ))}
      <li><a href={`/${LATEST.slug}/`}>{LATEST.label}</a></li>
    </ul>
  </div>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding: 80px 0 100px;
  }
  .notfound-code {
    font-family: var(--font-serif);
    font-size: clamp(4rem, 16vw, 8rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-red);
  }
  .notfound-title {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    margin-top: 12px;
  }
  .notfound-text {
    color: var(--color-text-muted);
    margin-top: 12px;
  }
  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
  .notfound-links a {
    display: inline-block;
    padding: 10px 16px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-text);
  }
  .notfound-links a:hover {
    border-color: var(--color-red);
    color: var(--color-red);
  }
</style>
