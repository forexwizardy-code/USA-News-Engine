---
import { readFile, readdir } from 'node:fs/promises';
import { join } from 'node:path';
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { formatDateTime, iso } from '../../lib/articles';

/**
 * Hidden preview route for the earthquake test fixture (Phase 8B).
 *
 * This route is NOT linked anywhere on the public site. It renders the test
 * fixture (a synthetic U.S. earthquake that does NOT exist in the USGS feed)
 * using the production article design so editors can review the earthquake
 * article + image pipeline before any real earthquake is ever published.
 *
 * Safety constraints:
 *   - The test fixture carries `testOnly: true` and a `TEST_FIXTURE_001`
 *     eventId that does not correspond to any real USGS event.
 *   - The page renders a prominent "TEST FIXTURE — NOT A REAL EARTHQUAKE"
 *     banner above the article.
 *   - <meta name="robots" content="noindex,nofollow,noarchive"> (PreviewLayout)
 *   - NO NewsArticle structured data (PreviewLayout)
 *   - Self-referencing canonical
 *   - The "View official USGS event →" link points at a fake URL
 *     (https://earthquake.usgs.gov/earthquakes/eventpage/TEST_FIXTURE_001)
 *     so a click is harmless even if a curious reader finds the page.
 *   - Excluded from the sitemap (handled by the existing /preview/ filter).
 *
 * Reads:
 *   - data/earthquakes/test-fixture.json (always present)
 *   - data/earthquakes/drafts/<slug>.json (generated by
 *     `node scripts/generate-earthquake-draft.mjs --fixture`)
 *   - data/draft-images/<slug>.json (image sidecar, generated by
 *     `node scripts/generate-earthquake-image.mjs --fixture`)
 *
 * If the draft or image sidecar are missing, the page still renders with a
 * placeholder section instructing the editor to run the test commands.
 */

interface EarthquakeFixture {
  testOnly: boolean;
  earthquakeKey: string;
  eventId: string;
  source: string;
  sourceId: string;
  magnitude: number;
  magnitudeType: string;
  place: string;
  title: string;
  time: string;
  updated: string;
  url: string;
  felt: number;
  cdi: number;
  mmi: number | null;
  alert: string | null;
  status: string;
  tsunami: boolean;
  significance: number;
  depthKm: number;
  latitude: number;
  longitude: number;
  country: string;
  state: string | null;
  isUS: boolean;
  isUSRelevant: boolean;
  impactRelevant: boolean;
  publishEligible: boolean;
  priority: string;
  storyScore: number;
  hasShakeMap: boolean;
  shakeMapImageUrl: string | null;
  hasDyfi: boolean;
  hasMomentTensor: boolean;
  hasTsunamiProduct: boolean;
}

interface DraftSection {
  heading: string | null;
  paragraphs: string[];
}

interface Draft {
  draftVersion: number;
  generatedAt: string;
  earthquakeKey: string;
  eventId: string;
  status: string;
  title: string;
  description: string;
  slug: string;
  category: string;
  location: string;
  publishedAt: string;
  updatedAt: string | null;
  breaking: boolean;
  author: string;
  sourceName: string;
  sourceUrl: string;
  sourceOffice: string;
  hasUpdates: boolean;
  seo: { title: string; description: string };
  image: {
    status: string;
    url: string | null;
    alt: string | null;
    source: string | null;
    license: string | null;
  };
  body: DraftSection[];
  earthquakeMetadata: Record<string, unknown>;
}

// --- Load the test fixture ------------------------------------------------
const fixturePath = join(process.cwd(), 'data', 'earthquakes', 'test-fixture.json');
let fixture: EarthquakeFixture | null = null;
try {
  const raw = await readFile(fixturePath, 'utf8');
  fixture = JSON.parse(raw);
} catch {
  // No fixture — page will render an error placeholder.
}

// --- Load the generated draft (if present) --------------------------------
let draft: Draft | null = null;
const draftsDir = join(process.cwd(), 'data', 'earthquakes', 'drafts');
if (fixture) {
  try {
    const files = await readdir(draftsDir);
    // Find the most-recently-modified draft whose earthquakeKey matches the fixture.
    let best: Draft | null = null;
    let bestTime = 0;
    for (const f of files) {
      if (!f.endsWith('.json')) continue;
      try {
        const d: Draft = JSON.parse(await readFile(join(draftsDir, f), 'utf8'));
        if (d.earthquakeKey !== fixture!.earthquakeKey) continue;
        const t = d.generatedAt ? new Date(d.generatedAt).getTime() : 0;
        if (t >= bestTime) {
          bestTime = t;
          best = d;
        }
      } catch {
        // skip
      }
    }
    draft = best;
  } catch {
    // No drafts directory — fall through to placeholder.
  }
}

// --- Load the image sidecar + image file ----------------------------------
let heroImage: string | null = null;
let heroImageExt: string | null = null;
let imageCaption = '';
let imageAttribution = '';
let imageAlt = draft?.image?.alt || '';
let imageMode: string | null = null;
if (draft) {
  const previewImagesDir = join(process.cwd(), 'public', 'preview-images');
  try {
    const allImages = await readdir(previewImagesDir);
    if (allImages.includes(`${draft.slug}.jpg`)) {
      heroImage = `/preview-images/${draft.slug}.jpg`;
      heroImageExt = 'jpg';
    } else if (allImages.includes(`${draft.slug}.png`)) {
      heroImage = `/preview-images/${draft.slug}.png`;
      heroImageExt = 'png';
    }
  } catch {
    // No preview-images directory — fall through.
  }
  if (heroImageExt) {
    const metaPath = join(process.cwd(), 'data', 'draft-images', `${draft.slug}.json`);
    try {
      const meta = JSON.parse(await readFile(metaPath, 'utf8'));
      imageCaption = meta.caption || '';
      imageAttribution = meta.licenseNotes || '';
      imageAlt = meta.alt || imageAlt;
      imageMode = meta.imageMode || null;
    } catch {
      // No sidecar — minimal caption.
    }
  }
}

// --- Parse timestamps -----------------------------------------------------
const publishedAt = draft ? new Date(draft.publishedAt) : new Date();
const updatedAt = draft?.updatedAt ? new Date(draft.updatedAt) : null;
const publishedDisplay = formatDateTime(publishedAt);
const updatedDisplay = updatedAt ? formatDateTime(updatedAt) : null;

// --- Preview path (self-referencing canonical) ----------------------------
const previewPath = `/preview/earthquake-test/`;

// --- Source attribution (USGS, but link is intentionally fake) ------------
const sourceOrganization = 'U.S. Geological Survey';
const sourceUrl = fixture?.url || 'https://earthquake.usgs.gov/earthquakes/eventpage/TEST_FIXTURE_001';
const sourceUrlLabel = 'View official USGS event \u2192';

// --- Breadcrumbs ----------------------------------------------------------
const breadcrumbs = [
  { name: 'Preview' },
  { name: draft?.title || 'Earthquake Test Fixture' },
];

// --- Title + description fallback (when no draft) -------------------------
const title = draft?.title || 'Earthquake Test Fixture — Preview';
const description = draft?.description || 'Synthetic USGS earthquake test fixture for preview testing only.';
---

<PreviewLayout
  title={title}
  description={description}
  previewPath={previewPath}
  ogImage={heroImage || undefined}
  publishedTime={publishedAt}
  modifiedTime={updatedAt || undefined}
  author={draft?.author || 'US News Engine Weather Desk'}
  section="U.S."
>
  {/* TEST FIXTURE banner — sits above the article */}
  <div class="fixture-banner" role="status" aria-live="polite">
    <div class="container fixture-banner-inner">
      <strong>TEST FIXTURE — NOT A REAL EARTHQUAKE</strong>
      <span class="fixture-banner-text">
        This page renders a synthetic USGS test fixture (eventId TEST_FIXTURE_001)
        that does not exist in the live USGS feed. No article has been published.
        For preview/qa only.
      </span>
    </div>
  </div>

  <article class="article">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      {!fixture && (
        <div class="fixture-error">
          <h1>Test fixture missing</h1>
          <p>
            The file <code>data/earthquakes/test-fixture.json</code> could not be
            loaded. Run <code>git checkout data/earthquakes/test-fixture.json</code>
            to restore the test fixture.
          </p>
        </div>
      )}

      {fixture && !draft && (
        <div class="fixture-error">
          <h1>{title}</h1>
          <p>
            The test fixture is loaded, but no draft JSON was found in
            <code>data/earthquakes/drafts/</code>. Generate the draft first:
          </p>
          <pre><code>node scripts/generate-earthquake-draft.mjs --fixture</code></pre>
          <p>Then refresh this page to see the rendered article.</p>
        </div>
      )}

      {fixture && draft && (
        <>
          <header class="article-head">
            <span class="cat-badge cat-badge--solid">U.S.</span>
            {draft.breaking && (
              <span class="breaking-tag" aria-label="Breaking news">
                <span class="breaking-dot" aria-hidden="true"></span>
                Breaking
              </span>
            )}
            <h1 class="article-title">{draft.title}</h1>
            <p class="article-dek">{draft.description}</p>

            <div class="article-meta">
              <div class="meta-block meta-byline">
                <span class="meta-label">By</span>
                <span class="meta-author">{draft.author}</span>
              </div>
              <div class="meta-dates">
                <div class="meta-block">
                  <span class="meta-label">Published</span>
                  <time class="meta-value" datetime={iso(publishedAt)}>
                    {publishedDisplay}
                  </time>
                </div>
                {
                  updatedDisplay && updatedAt && updatedAt.getTime() > publishedAt.getTime() && (
                    <div class="meta-block">
                      <span class="meta-label">Updated</span>
                      <time class="meta-value" datetime={iso(updatedAt)}>
                        {updatedDisplay}
                      </time>
                    </div>
                  )
                }
              </div>
            </div>
          </header>

          {heroImage && (
            <figure class="article-figure">
              <img
                src={heroImage}
                alt={imageAlt}
                width="1200"
                height="675"
                loading="eager"
                fetchpriority="high"
              />
              <figcaption>
                <span class="figcaption-text">{imageCaption}</span>
                {imageAttribution && (
                  <span class="figcaption-attribution">{imageAttribution}</span>
                )}
              </figcaption>
            </figure>
          )}

          <div class="article-columns">
            <div class="article-content">
              <div class="article-body">
                {draft.body.map((section) => (
                  <div class="draft-section">
                    {section.heading && <h2>{section.heading}</h2>}
                    {section.paragraphs.map((p) => (
                      <p set:html={p}></p>
                    ))}
                  </div>
                ))}
              </div>

              <div class="article-source">
                <p class="source-label">Source</p>
                <div class="source-grid">
                  <div class="source-row">
                    <span class="source-key">Organization</span>
                    <span class="source-val">{sourceOrganization}</span>
                  </div>
                  <div class="source-row">
                    <span class="source-key">Office</span>
                    <span class="source-val">{draft.sourceOffice}</span>
                  </div>
                  <div class="source-row">
                    <span class="source-key">Event ID (test)</span>
                    <span class="source-val">{fixture.eventId}</span>
                  </div>
                  <div class="source-row">
                    <span class="source-key">Original event page</span>
                    <a
                      class="source-link"
                      href={sourceUrl}
                      rel="nofollow noopener"
                      target="_blank"
                    >
                      {sourceUrlLabel}
                    </a>
                  </div>
                </div>
                <p class="source-note">
                  This article was produced from a synthetic test fixture
                  modeled on the U.S. Geological Survey earthquake schema. The
                  link above points to a non-existent USGS event page
                  (TEST_FIXTURE_001) and is included only to demonstrate the
                  source-box layout. US News Engine is not the original source
                  of any earthquake data.
                </p>
              </div>
            </div>

            <aside class="article-aside" aria-label="Article details">
              <div class="aside-card">
                <p class="aside-title">Earthquake details</p>
                <dl class="aside-list">
                  <div>
                    <dt>Category</dt>
                    <dd>Weather</dd>
                  </div>
                  <div>
                    <dt>Source</dt>
                    <dd>{sourceOrganization}</dd>
                  </div>
                  <div>
                    <dt>Magnitude</dt>
                    <dd>M{fixture.magnitude.toFixed(1)} ({fixture.magnitudeType})</dd>
                  </div>
                  <div>
                    <dt>Depth</dt>
                    <dd>{fixture.depthKm} km</dd>
                  </div>
                  <div>
                    <dt>Place</dt>
                    <dd>{fixture.place}</dd>
                  </div>
                  {fixture.state && (
                    <div>
                      <dt>State</dt>
                      <dd>{fixture.state}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Coordinates</dt>
                    <dd>{Math.abs(fixture.latitude).toFixed(4)}°{fixture.latitude >= 0 ? 'N' : 'S'}, {Math.abs(fixture.longitude).toFixed(4)}°{fixture.longitude >= 0 ? 'E' : 'W'}</dd>
                  </div>
                  <div>
                    <dt>Felt reports</dt>
                    <dd>{fixture.felt.toLocaleString()}</dd>
                  </div>
                  {fixture.cdi != null && (
                    <div>
                      <dt>CDI</dt>
                      <dd>{fixture.cdi.toFixed(1)}</dd>
                    </div>
                  )}
                  <div>
                    <dt>PAGER alert</dt>
                    <dd>{fixture.alert || 'none'}</dd>
                  </div>
                  <div>
                    <dt>Tsunami flag</dt>
                    <dd>{fixture.tsunami ? 'Yes' : 'No'}</dd>
                  </div>
                  <div>
                    <dt>Significance</dt>
                    <dd>{fixture.significance}</dd>
                  </div>
                  <div>
                    <dt>Status</dt>
                    <dd>{fixture.status}</dd>
                  </div>
                  <div>
                    <dt>Story score</dt>
                    <dd>{fixture.storyScore}</dd>
                  </div>
                  <div>
                    <dt>Priority</dt>
                    <dd>{fixture.priority}</dd>
                  </div>
                  <div>
                    <dt>Has ShakeMap</dt>
                    <dd>{fixture.hasShakeMap ? 'Yes' : 'No'}</dd>
                  </div>
                  <div>
                    <dt>Has DYFI</dt>
                    <dd>{fixture.hasDyfi ? 'Yes' : 'No'}</dd>
                  </div>
                  <div>
                    <dt>Test only</dt>
                    <dd>{fixture.testOnly ? 'Yes' : 'No'}</dd>
                  </div>
                </dl>
              </div>
            </aside>
          </div>
        </>
      )}
    </div>
  </article>
</PreviewLayout>

<style>
  .fixture-banner {
    background: #5a2a0a;
    color: #fff;
    border-bottom: 2px solid #3a1a04;
    position: relative;
    z-index: 60;
  }
  .fixture-banner-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding-block: 8px;
    flex-wrap: wrap;
  }
  .fixture-banner strong {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #c8102e;
    padding: 4px 8px;
    border-radius: 2px;
  }
  .fixture-banner-text {
    font-size: 0.82rem;
    color: #f5d8c0;
  }
  @media (max-width: 600px) {
    .fixture-banner-text {
      display: none;
    }
  }

  .article {
    padding-bottom: 8px;
  }
  .article-head {
    max-width: 820px;
    margin: 8px auto 24px;
  }
  .article-title {
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 1.08;
    margin: 16px 0 14px;
  }
  .article-dek {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .meta-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .meta-author {
    font-weight: 700;
    color: var(--color-text);
  }
  .meta-value {
    font-size: 0.92rem;
    color: var(--color-text);
  }

  .cat-badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 2px;
    line-height: 1;
  }
  .cat-badge--solid {
    background: #1f6f8b;
    color: #fff;
  }

  .breaking-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    padding: 4px 8px;
    background: #7a1f3a;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 2px;
    line-height: 1;
  }
  .breaking-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff9aa6;
    animation: breaking-pulse 1.4s ease-in-out infinite;
  }
  @keyframes breaking-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .article-figure {
    margin: 8px 0 32px;
  }
  .article-figure img {
    width: 100%;
    border-radius: var(--radius);
  }
  .article-figure figcaption {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 8px;
    padding-left: 12px;
    border-left: 3px solid var(--color-border-strong);
  }
  .figcaption-text {
    display: block;
  }
  .figcaption-attribution {
    display: block;
    margin-top: 3px;
    color: var(--color-text-soft);
    font-style: italic;
  }

  .article-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }
  .article-content {
    max-width: 720px;
  }

  .article-body {
    font-size: 1.075rem;
    line-height: 1.75;
    color: #23262b;
  }
  .article-body > * + * {
    margin-top: 1.25rem;
  }
  .article-body h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
  }
  .article-body p {
    margin-top: 1.15rem;
  }
  .draft-section {
    margin-top: 1.5rem;
  }
  .draft-section:first-child {
    margin-top: 0;
  }

  .article-source {
    margin-top: 36px;
    padding: 24px;
    background: var(--color-surface-alt);
    border-left: 4px solid #1f6f8b;
    border-radius: var(--radius);
  }
  .source-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }
  .source-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .source-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .source-key {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-muted);
    min-width: 150px;
    flex-shrink: 0;
  }
  .source-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .source-link {
    font-size: 0.9rem;
    color: #1f5f7a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .source-link:hover {
    color: #2a7a8a;
  }
  .source-note {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
    color: var(--color-text-soft);
    font-style: italic;
  }

  .aside-card {
    position: sticky;
    top: 72px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1f6f8b;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-text);
    margin-bottom: 14px;
  }
  .aside-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .aside-list dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .aside-list dd {
    font-size: 0.92rem;
    margin-top: 2px;
  }

  .fixture-error {
    margin: 32px auto;
    max-width: 720px;
    padding: 24px;
    background: var(--color-surface-alt);
    border-left: 4px solid var(--color-red);
    border-radius: var(--radius);
  }
  .fixture-error h1 {
    font-size: 1.5rem;
    margin-bottom: 12px;
  }
  .fixture-error p {
    margin-bottom: 12px;
    font-size: 0.95rem;
  }
  .fixture-error pre {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 12px;
    border-radius: 4px;
    overflow-x: auto;
  }
  .fixture-error code {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: #c8102e;
  }
  .fixture-error pre code {
    color: var(--color-text);
  }

  @media (max-width: 860px) {
    .article-columns {
      grid-template-columns: 1fr;
    }
    .aside-card {
      position: static;
    }
  }
  @media (max-width: 620px) {
    .article-meta {
      gap: 10px;
      flex-direction: column;
      align-items: flex-start;
    }
    .meta-byline {
      width: 100%;
    }
    .meta-dates {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 20px;
      width: 100%;
    }
    .meta-dates .meta-block {
      flex-direction: row;
      align-items: baseline;
      gap: 6px;
    }
    .meta-dates .meta-label {
      font-size: 0.62rem;
    }
    .meta-dates .meta-value {
      font-size: 0.85rem;
    }
    .source-row {
      flex-direction: column;
      gap: 2px;
    }
    .source-key {
      min-width: 0;
    }
  }
</style>
