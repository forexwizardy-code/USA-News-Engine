---
import { readFile, readdir } from 'node:fs/promises';
import { join } from 'node:path';
import PreviewLayout from '../../../layouts/PreviewLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { formatDateTime, iso } from '../../../lib/articles';

/**
 * Hidden preview route for Science article drafts (Phase 9B).
 *
 * This route is NOT linked anywhere on the public site. It is only accessible
 * when someone knows the exact URL. It renders a private Science draft using
 * the production article design so editors can review the article + image
 * before publication.
 *
 * Key differences from the recall preview (src/pages/preview/recall/[slug].astro):
 *   - Category label: "Science" (not "Recalls")
 *   - Author: "US News Engine Science Desk"
 *   - Source box: shows organization (NASA or NASA JPL), a "View official
 *     NASA story →" / "View official JPL story →" link, and the source
 *     publication date.
 *   - Hero image: verified-agency / mixed-agency official image, OR an
 *     editorial Science graphic (no fake space photography).
 *   - <meta name="robots" content="noindex,nofollow,noarchive">
 *   - NO NewsArticle schema (handled by PreviewLayout).
 *   - Self-referencing canonical.
 *   - Excluded from sitemap (handled by the existing /preview/ filter).
 *   - Includes a claim-audit panel showing how each substantive claim
 *     traces back to the source article (for editorial review).
 *
 * Reads the draft JSON from data/science/drafts/<slug>.json.
 * Reads the image from /preview-images/<slug>.jpg or .png.
 */

interface DraftSection {
  heading: string | null;
  paragraphs: string[];
}

interface ClaimAuditEntry {
  claim: string;
  sourceField: string;
  sourceEvidence: string;
  inHeadline: boolean;
  inBody: boolean;
}

interface ScienceMetadata {
  storyType: string | null;
  mission: string | null;
  topic: string | null;
  primarySource: string;
  allSourceKeys: string[];
  sourceUrls: string[];
  storyScore: number | null;
  priority: string | null;
  publishEligible: boolean;
  freshnessStatus: string | null;
  bootstrapSeen: boolean;
}

interface Draft {
  draftVersion: number;
  generatedAt: string;
  scienceStoryKey: string;
  status: string;
  title: string;
  description: string;
  slug: string;
  category: string;
  author: string;
  publishedAt: string;
  updatedAt: string | null;
  sourcePublishedAt: string | null;
  breaking: boolean;
  sourceName: string;
  sourceUrl: string;
  sourceOffice: string;
  seo: { title: string; description: string };
  image: {
    status: string;
    rightsStatus: string;
    mode: string;
    url: string | null;
    alt: string | null;
    credit: string | null;
    caption: string | null;
    sourcePageUrl: string;
    originalImageUrl: string | null;
    sourceConfirmed: boolean;
  };
  body: DraftSection[];
  scienceMetadata: ScienceMetadata;
  claimAudit: ClaimAuditEntry[];
}

export async function getStaticPaths() {
  // Only generate preview pages for science drafts that actually exist.
  const draftsDir = join(process.cwd(), 'data', 'science', 'drafts');
  let files: string[] = [];
  try {
    files = await readdir(draftsDir);
  } catch {
    // No drafts directory — no preview pages.
    return [];
  }
  return files
    .filter((f) => f.endsWith('.json'))
    .map((f) => {
      const slug = f.replace(/\.json$/, '');
      return { params: { slug }, props: { slug } };
    });
}

interface Props {
  slug: string;
}
const { slug } = Astro.props;

// Load the draft JSON.
const draftPath = join(process.cwd(), 'data', 'science', 'drafts', `${slug}.json`);
let draftRaw: string;
try {
  draftRaw = await readFile(draftPath, 'utf8');
} catch {
  return Astro.redirect('/404');
}
const draft: Draft = JSON.parse(draftRaw);

// Resolve the hero image: prefer .jpg (official agency image), fall back to
// .png (editorial graphic). Both live under /preview-images/.
let heroImage: string | null = null;
let heroImageExt: string | null = null;
const previewImagesDir = join(process.cwd(), 'public', 'preview-images');
try {
  const allImages = await readdir(previewImagesDir);
  if (allImages.includes(`${slug}.jpg`)) {
    heroImage = `/preview-images/${slug}.jpg`;
    heroImageExt = 'jpg';
  } else if (allImages.includes(`${slug}.png`)) {
    heroImage = `/preview-images/${slug}.png`;
    heroImageExt = 'png';
  }
} catch {
  // No preview-images directory — fall through to no image.
}

// Load image metadata sidecar (if it exists) to get caption + credit.
//
// IMPORTANT: Public-facing figure rendering shows ONLY:
//   - the factual `caption` text
//   - the exact source `credit` line
// The `licenseNotes` field (which carries internal rights-policy reminders) is
// kept in the JSON for editorial use but is NEVER rendered on the page — not
// in previews, and definitely not on public articles.
let imageCaption = '';
let imageCredit = '';
let imageAlt = draft.image?.alt || draft.title;
let imageMode: string | null = null;
let imageRightsStatus: string | null = null;
let originalImageUrl: string | null = null;
let creditVerification: { verified: boolean; reason: string } | null = null;
if (heroImageExt) {
  const metaPath = join(process.cwd(), 'data', 'draft-images', `${slug}.json`);
  try {
    const metaRaw = await readFile(metaPath, 'utf8');
    const meta = JSON.parse(metaRaw);
    imageCaption = meta.caption || '';
    imageCredit = meta.credit || '';
    imageAlt = meta.alt || imageAlt;
    imageMode = meta.imageMode || null;
    imageRightsStatus = meta.rightsStatus || null;
    originalImageUrl = meta.originalImageUrl || null;
    creditVerification = meta.creditVerification || null;
  } catch {
    // No metadata sidecar — use minimal caption.
  }
}

// Parse timestamps.
const publishedAt = new Date(draft.publishedAt);
const updatedAt = draft.updatedAt ? new Date(draft.updatedAt) : null;
const sourcePublishedAt = draft.sourcePublishedAt ? new Date(draft.sourcePublishedAt) : null;
const publishedDisplay = formatDateTime(publishedAt);
const updatedDisplay = updatedAt ? formatDateTime(updatedAt) : null;
const sourcePublishedDisplay = sourcePublishedAt ? formatDateTime(sourcePublishedAt) : null;

// Build the preview path (self-referencing canonical).
const previewPath = `/preview/science/${slug}/`;

// Source attribution — adapt to NASA vs NASA JPL.
const isJpl = draft.scienceMetadata?.primarySource === 'JPL';
const sourceOrganization = draft.sourceName;
const sourceUrl = draft.sourceUrl;
const sourceUrlLabel = isJpl
  ? 'View official JPL story \u2192'
  : 'View official NASA story \u2192';

// Breadcrumbs — preview only.
const breadcrumbs = [
  { name: 'Preview' },
  { name: draft.title },
];

// Claim-audit summary for editorial review panel.
const claimCount = draft.claimAudit?.length || 0;
const headlineClaims = draft.claimAudit?.filter((c) => c.inHeadline).length || 0;
const bodyClaims = draft.claimAudit?.filter((c) => c.inBody).length || 0;
---

<PreviewLayout
  title={draft.title}
  description={draft.description}
  previewPath={previewPath}
  ogImage={heroImage || undefined}
  publishedTime={publishedAt}
  modifiedTime={updatedAt || undefined}
  author={draft.author}
  section="Science"
>
  <article class="article">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="article-head">
        <span class="cat-badge cat-badge--science">Science</span>
        {draft.breaking && (
          <span class="breaking-tag" aria-label="Breaking news">
            <span class="breaking-dot" aria-hidden="true"></span>
            Breaking
          </span>
        )}
        <h1 class="article-title">{draft.title}</h1>
        <p class="article-dek">{draft.description}</p>

        <div class="article-meta">
          <div class="meta-block meta-byline">
            <span class="meta-label">By</span>
            <span class="meta-author">{draft.author}</span>
          </div>
          <div class="meta-dates">
            <div class="meta-block">
              <span class="meta-label">Preview generated</span>
              <time class="meta-value" datetime={iso(publishedAt)}>
                {publishedDisplay}
              </time>
            </div>
            {sourcePublishedDisplay && (
              <div class="meta-block">
                <span class="meta-label">Source published</span>
                <time class="meta-value" datetime={iso(sourcePublishedAt)}>
                  {sourcePublishedDisplay}
                </time>
              </div>
            )}
            {
              updatedDisplay && updatedAt && updatedAt.getTime() > publishedAt.getTime() && (
                <div class="meta-block">
                  <span class="meta-label">Updated</span>
                  <time class="meta-value" datetime={iso(updatedAt)}>
                    {updatedDisplay}
                  </time>
                </div>
              )
            }
          </div>
        </div>
      </header>

      {heroImage && (
        <figure class="article-figure">
          <img
            src={heroImage}
            alt={imageAlt}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>
            <span class="figcaption-text">{imageCaption}</span>
            {imageCredit && (
              <span class="figcaption-attribution">Credit: {imageCredit}</span>
            )}
          </figcaption>
        </figure>
      )}

      <div class="article-columns">
        <div class="article-content">
          <div class="article-body">
            {draft.body.map((section) => (
              <div class="draft-section">
                {section.heading && <h2>{section.heading}</h2>}
                {section.paragraphs.map((p) => (
                  <p set:html={p}></p>
                ))}
              </div>
            ))}
          </div>

          <div class="article-source">
            <p class="source-label">Source</p>
            <div class="source-grid">
              <div class="source-row">
                <span class="source-key">Organization</span>
                <span class="source-val">{sourceOrganization}</span>
              </div>
              {draft.sourceOffice && (
                <div class="source-row">
                  <span class="source-key">Office</span>
                  <span class="source-val">{draft.sourceOffice}</span>
                </div>
              )}
              {draft.scienceMetadata?.storyType && (
                <div class="source-row">
                  <span class="source-key">Story type</span>
                  <span class="source-val">{draft.scienceMetadata.storyType}</span>
                </div>
              )}
              {draft.scienceMetadata?.mission && (
                <div class="source-row">
                  <span class="source-key">Mission</span>
                  <span class="source-val">{draft.scienceMetadata.mission}</span>
                </div>
              )}
              {sourcePublishedDisplay && (
                <div class="source-row">
                  <span class="source-key">Source published</span>
                  <span class="source-val">{sourcePublishedDisplay}</span>
                </div>
              )}
              {sourceUrl && (
                <div class="source-row">
                  <span class="source-key">Official story</span>
                  <a
                    class="source-link"
                    href={sourceUrl}
                    rel="nofollow noopener"
                    target="_blank"
                  >
                    {sourceUrlLabel}
                  </a>
                </div>
              )}
            </div>
            <p class="source-note">
              This article was produced from an official {isJpl ? 'NASA Jet Propulsion Laboratory' : 'NASA'} source article. US News Engine is not the original source of this story; the headline and body summarize the source article's reported findings.
            </p>
          </div>

          {draft.claimAudit && draft.claimAudit.length > 0 && (
            <div class="claim-audit">
              <p class="claim-audit-title">Claim audit (editorial review only)</p>
              <p class="claim-audit-summary">
                {claimCount} substantive claims traced to source ·
                {' '}{headlineClaims} in headline · {bodyClaims} in body.
              </p>
              <ol class="claim-audit-list">
                {draft.claimAudit.map((entry) => (
                  <li class="claim-audit-item">
                    <p class="claim-audit-claim">
                      <span class="claim-audit-tags">
                        {entry.inHeadline && <span class="claim-tag claim-tag--headline">H</span>}
                        {entry.inBody && <span class="claim-tag claim-tag--body">B</span>}
                      </span>
                      {entry.claim}
                    </p>
                    <p class="claim-audit-evidence">
                      <span class="claim-audit-source">{entry.sourceField}</span>
                      {' '}{entry.sourceEvidence}
                    </p>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>

        <aside class="article-aside" aria-label="Article details">
          <div class="aside-card">
            <p class="aside-title">Science details</p>
            <dl class="aside-list">
              <div>
                <dt>Category</dt>
                <dd>Science</dd>
              </div>
              <div>
                <dt>Source</dt>
                <dd>{sourceOrganization}</dd>
              </div>
              {draft.scienceMetadata?.storyType && (
                <div>
                  <dt>Story type</dt>
                  <dd>{draft.scienceMetadata.storyType}</dd>
                </div>
              )}
              {draft.scienceMetadata?.mission && (
                <div>
                  <dt>Mission</dt>
                  <dd>{draft.scienceMetadata.mission}</dd>
                </div>
              )}
              {draft.scienceMetadata?.topic && (
                <div>
                  <dt>Topic</dt>
                  <dd>{draft.scienceMetadata.topic}</dd>
                </div>
              )}
              {draft.scienceMetadata?.priority && (
                <div>
                  <dt>Priority</dt>
                  <dd>{draft.scienceMetadata.priority}</dd>
                </div>
              )}
              {draft.scienceMetadata?.freshnessStatus && (
                <div>
                  <dt>Freshness</dt>
                  <dd>{draft.scienceMetadata.freshnessStatus}</dd>
                </div>
              )}
              {imageMode && (
                <div>
                  <dt>Image mode</dt>
                  <dd>{imageMode}</dd>
                </div>
              )}
              {imageRightsStatus && (
                <div>
                  <dt>Image rights</dt>
                  <dd>{imageRightsStatus}</dd>
                </div>
              )}
              {creditVerification && (
                <div>
                  <dt>Credit check</dt>
                  <dd>{creditVerification.verified ? 'verified' : 'not used'}</dd>
                </div>
              )}
              {sourcePublishedDisplay && (
                <div>
                  <dt>Source published</dt>
                  <dd>{sourcePublishedDisplay}</dd>
                </div>
              )}
              <div>
                <dt>Preview generated</dt>
                <dd>{publishedDisplay}</dd>
              </div>
              <div>
                <dt>Updated</dt>
                <dd>{updatedDisplay || 'Not yet updated'}</dd>
              </div>
              <div>
                <dt>Story key</dt>
                <dd class="story-key">{draft.scienceStoryKey}</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </article>
</PreviewLayout>

<style>
  .article {
    padding-bottom: 8px;
  }
  .article-head {
    max-width: 820px;
    margin: 8px auto 24px;
  }
  .article-title {
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 1.08;
    margin: 16px 0 14px;
  }
  .article-dek {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .meta-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .meta-author {
    font-weight: 700;
    color: var(--color-text);
  }
  .meta-value {
    font-size: 0.92rem;
    color: var(--color-text);
  }

  .cat-badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 2px;
    line-height: 1;
  }
  .cat-badge--science {
    background: #0a3a5c;
    color: #fff;
  }

  .breaking-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    padding: 4px 8px;
    background: #7a1f3a;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 2px;
    line-height: 1;
  }
  .breaking-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff9aa6;
    animation: breaking-pulse 1.4s ease-in-out infinite;
  }
  @keyframes breaking-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .article-figure {
    margin: 8px 0 32px;
  }
  .article-figure img {
    width: 100%;
    border-radius: var(--radius);
  }
  .article-figure figcaption {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 8px;
    padding-left: 12px;
    border-left: 3px solid var(--color-border-strong);
  }
  .figcaption-text {
    display: block;
  }
  .figcaption-attribution {
    display: block;
    margin-top: 3px;
    color: var(--color-text-soft);
    font-style: italic;
  }

  .article-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }
  .article-content {
    max-width: 720px;
  }

  .article-body {
    font-size: 1.075rem;
    line-height: 1.75;
    color: #23262b;
  }
  .article-body > * + * {
    margin-top: 1.25rem;
  }
  .article-body h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
  }
  .article-body p {
    margin-top: 1.15rem;
  }
  .draft-section {
    margin-top: 1.5rem;
  }
  .draft-section:first-child {
    margin-top: 0;
  }

  /* Source box */
  .article-source {
    margin-top: 36px;
    padding: 24px;
    background: var(--color-surface-alt);
    border-left: 4px solid #0a3a5c;
    border-radius: var(--radius);
  }
  .source-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }
  .source-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .source-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .source-key {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-muted);
    min-width: 140px;
    flex-shrink: 0;
  }
  .source-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .source-link {
    font-size: 0.9rem;
    color: #0a3a5c;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .source-link:hover {
    color: #0a5278;
  }
  .source-note {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
    color: var(--color-text-soft);
    font-style: italic;
  }

  /* Claim audit panel */
  .claim-audit {
    margin-top: 36px;
    padding: 24px;
    background: #fff8e6;
    border: 1px dashed #c9a23a;
    border-radius: var(--radius);
  }
  .claim-audit-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b5410;
    padding-bottom: 8px;
    border-bottom: 1px solid #d4b65a;
    margin-bottom: 8px;
  }
  .claim-audit-summary {
    font-size: 0.85rem;
    color: #4a3c08;
    margin-bottom: 14px;
  }
  .claim-audit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .claim-audit-item {
    padding-left: 0;
  }
  .claim-audit-claim {
    font-size: 0.92rem;
    color: #2c2410;
    font-weight: 600;
    margin-bottom: 4px;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .claim-audit-tags {
    flex-shrink: 0;
    display: inline-flex;
    gap: 4px;
  }
  .claim-tag {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 2px 5px;
    border-radius: 2px;
    line-height: 1;
  }
  .claim-tag--headline {
    background: #7a1f3a;
    color: #fff;
  }
  .claim-tag--body {
    background: #0a3a5c;
    color: #fff;
  }
  .claim-audit-evidence {
    font-size: 0.82rem;
    color: #5a4a18;
    font-style: italic;
    padding-left: 28px;
  }
  .claim-audit-source {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a6e1c;
    font-style: normal;
    margin-right: 6px;
  }

  /* Aside */
  .aside-card {
    position: sticky;
    top: 72px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0a3a5c;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-text);
    margin-bottom: 14px;
  }
  .aside-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .aside-list dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .aside-list dd {
    font-size: 0.92rem;
    margin-top: 2px;
  }
  .aside-list .story-key {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    word-break: break-all;
  }

  @media (max-width: 860px) {
    .article-columns {
      grid-template-columns: 1fr;
    }
    .aside-card {
      position: static;
    }
  }
  @media (max-width: 620px) {
    .article-meta {
      gap: 10px;
      flex-direction: column;
      align-items: flex-start;
    }
    .meta-byline {
      width: 100%;
    }
    .meta-dates {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 20px;
      width: 100%;
    }
    .meta-dates .meta-block {
      flex-direction: row;
      align-items: baseline;
      gap: 6px;
    }
    .meta-dates .meta-label {
      font-size: 0.62rem;
    }
    .meta-dates .meta-value {
      font-size: 0.85rem;
    }
    .source-row {
      flex-direction: column;
      gap: 2px;
    }
    .source-key {
      min-width: 0;
    }
  }
</style>
