---
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { formatDateTime, iso } from '../../lib/articles';

/**
 * Hidden preview route for NWS article drafts.
 *
 * This route is NOT linked anywhere on the public site. It is only accessible
 * when someone knows the exact URL. It renders a private draft using the real
 * production article design so editors can review the article + image before
 * publication.
 *
 * Constraints:
 *   - NOT in the content collection (reads from data/drafts/)
 *   - NOT in the sitemap
 *   - noindex,nofollow,noarchive
 *   - NO NewsArticle structured data
 *   - Self-referencing canonical (preview URL only)
 *   - NOT linked from homepage, category pages, related stories, etc.
 */

interface DraftSection {
  heading: string | null;
  paragraphs: string[];
}

interface Draft {
  draftVersion: number;
  storyKey: string;
  sourceAlertIds: string[];
  status: string;
  title: string;
  description: string;
  slug: string;
  category: string;
  location: string;
  publishedAt: string;
  updatedAt: string;
  breaking: boolean;
  author: string;
  sourceName: string;
  sourceUrl: string;
  sourceOffice: string;
  hasUpdates: boolean;
  originalInstruction: string | null;
  seo: { title: string; description: string };
  image: {
    status: string;
    url: string | null;
    draftPath: string;
    alt: string;
    source: string;
    dataSource: string;
    license: string;
  };
  body: DraftSection[];
  weatherMetadata: {
    event: string;
    severity: string;
    certainty: string;
    urgency: string;
    effective: string;
    onset: string;
    expires: string;
    ends: string;
    affectedZones: string[];
    priority: string;
    storyScore: number;
    updateCount: number;
    firstEffectiveAt: string | null;
    latestEffectiveAt: string | null;
  };
}

export async function getStaticPaths() {
  // Only generate preview pages for drafts that actually exist.
  // This keeps the preview system reusable — drop a new draft JSON in
  // data/drafts/ and it gets a preview page on the next build.
  const { readdir } = await import('node:fs/promises');
  const draftsDir = join(process.cwd(), 'data', 'drafts');
  let files: string[] = [];
  try {
    files = await readdir(draftsDir);
  } catch {
    // No drafts directory — no preview pages.
    return [];
  }
  return files
    .filter((f) => f.endsWith('.json'))
    .map((f) => {
      const storyKey = f.replace(/\.json$/, '');
      return { params: { slug: storyKey }, props: { storyKey } };
    });
}

interface Props {
  storyKey: string;
}
const { storyKey } = Astro.props;

// Load the draft JSON.
const draftPath = join(process.cwd(), 'data', 'drafts', `${storyKey}.json`);
let draftRaw: string;
try {
  draftRaw = await readFile(draftPath, 'utf8');
} catch {
  return Astro.redirect('/404');
}
const draft: Draft = JSON.parse(draftRaw);

// The hero image lives in public/preview-images/ (copied from data/draft-images/).
// Use the draft's slug for the filename.
const heroImage = `/preview-images/${draft.slug}.png`;

// Parse timestamps.
const publishedAt = new Date(draft.publishedAt);
const updatedAt = new Date(draft.updatedAt);
const effectiveDate = new Date(draft.weatherMetadata.effective);
const endsDate = new Date(draft.weatherMetadata.ends);

// Build the preview path (self-referencing canonical).
const previewPath = `/preview/${storyKey}/`;

// Breadcrumbs — preview only, no link to a public article.
const breadcrumbs = [
  { name: 'Preview' },
  { name: draft.title },
];
---

<PreviewLayout
  title={draft.title}
  description={draft.description}
  previewPath={previewPath}
  ogImage={heroImage}
  publishedTime={publishedAt}
  modifiedTime={updatedAt}
  author={draft.author}
  section="Weather"
>
  <article class="article">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="article-head">
        <span class="cat-badge cat-badge--solid">Weather</span>
        <h1 class="article-title">{draft.title}</h1>
        <p class="article-dek">{draft.description}</p>

        <div class="article-meta">
          <div class="meta-block">
            <span class="meta-label">By</span>
            <span class="meta-author">{draft.author}</span>
          </div>
          <div class="meta-block">
            <span class="meta-label">Published</span>
            <time class="meta-value" datetime={iso(publishedAt)}>
              {formatDateTime(publishedAt)}
            </time>
          </div>
          {
            updatedAt.getTime() !== publishedAt.getTime() && (
              <div class="meta-block">
                <span class="meta-label">Updated</span>
                <time class="meta-value" datetime={iso(updatedAt)}>
                  {formatDateTime(updatedAt)}
                </time>
              </div>
            )
          }
        </div>
      </header>

      <figure class="article-figure">
        <img
          src={heroImage}
          alt={draft.image.alt}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          {draft.image.alt}
          <span class="figcaption-source"> — {draft.image.source}</span>
        </figcaption>
      </figure>

      <div class="article-columns">
        <div class="article-content">
          <div class="article-body">
            {draft.body.map((section) => (
              <div class="draft-section">
                {section.heading && <h2>{section.heading}</h2>}
                {section.paragraphs.map((p) => (
                  <p set:html={p}></p>
                ))}
              </div>
            ))}
          </div>

          <!-- Source attribution box (clean, reader-facing) -->
          <div class="article-source">
            <p class="source-label">Source</p>
            <div class="source-grid">
              <div class="source-row">
                <span class="source-key">Organization</span>
                <span class="source-val">{draft.sourceName}</span>
              </div>
              <div class="source-row">
                <span class="source-key">Office</span>
                <span class="source-val">{draft.sourceOffice}</span>
              </div>
              <div class="source-row">
                <span class="source-key">Original alert</span>
                <a
                  class="source-link"
                  href={draft.sourceUrl}
                  rel="nofollow noopener"
                  target="_blank"
                >
                  View official NWS alert &rarr;
                </a>
              </div>
            </div>
            <p class="source-note">
              This article was produced from official National Weather Service alert data. US News Engine is not the original source of this alert.
            </p>
          </div>
        </div>

        <aside class="article-aside" aria-label="Article details">
          <div class="aside-card">
            <p class="aside-title">Story details</p>
            <dl class="aside-list">
              <div>
                <dt>Category</dt>
                <dd>Weather</dd>
              </div>
              <div>
                <dt>Location</dt>
                <dd>{draft.location}</dd>
              </div>
              <div>
                <dt>Author</dt>
                <dd>{draft.author}</dd>
              </div>
              <div>
                <dt>Published</dt>
                <dd>{formatDateTime(publishedAt)}</dd>
              </div>
              <div>
                <dt>Updated</dt>
                <dd>{formatDateTime(updatedAt)}</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </article>
</PreviewLayout>

<style>
  .article {
    padding-bottom: 8px;
  }
  .article-head {
    max-width: 820px;
    margin: 8px auto 24px;
  }
  .article-title {
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 1.08;
    margin: 16px 0 14px;
  }
  .article-dek {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .meta-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .meta-author {
    font-weight: 700;
    color: var(--color-text);
  }
  .meta-value {
    font-size: 0.92rem;
    color: var(--color-text);
  }

  .cat-badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 2px;
    line-height: 1;
  }
  .cat-badge--solid {
    background: var(--color-red);
    color: #fff;
  }

  .article-figure {
    margin: 8px 0 32px;
  }
  .article-figure img {
    width: 100%;
    border-radius: var(--radius);
  }
  .article-figure figcaption {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 8px;
    padding-left: 12px;
    border-left: 3px solid var(--color-border-strong);
  }
  .figcaption-source {
    color: var(--color-text-soft);
    font-style: italic;
  }

  .article-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }
  .article-content {
    max-width: 720px;
  }

  .article-body {
    font-size: 1.075rem;
    line-height: 1.75;
    color: #23262b;
  }
  .article-body > * + * {
    margin-top: 1.25rem;
  }
  .article-body h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
  }
  .article-body p {
    margin-top: 1.15rem;
  }
  .draft-section {
    margin-top: 1.5rem;
  }
  .draft-section:first-child {
    margin-top: 0;
  }

  /* Source box */
  .article-source {
    margin-top: 36px;
    padding: 24px;
    background: var(--color-surface-alt);
    border-left: 4px solid var(--color-red);
    border-radius: var(--radius);
  }
  .source-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }
  .source-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .source-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .source-key {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-muted);
    min-width: 110px;
    flex-shrink: 0;
  }
  .source-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .source-link {
    font-size: 0.9rem;
    color: var(--color-red-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .source-link:hover {
    color: var(--color-red);
  }
  .source-note {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
    color: var(--color-text-soft);
    font-style: italic;
  }

  /* Aside */
  .aside-card {
    position: sticky;
    top: 72px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-red);
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-text);
    margin-bottom: 14px;
  }
  .aside-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .aside-list dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .aside-list dd {
    font-size: 0.92rem;
    margin-top: 2px;
  }

  @media (max-width: 860px) {
    .article-columns {
      grid-template-columns: 1fr;
    }
    .aside-card {
      position: static;
    }
  }
  @media (max-width: 620px) {
    .article-meta {
      gap: 18px;
    }
    .source-row {
      flex-direction: column;
      gap: 2px;
    }
    .source-key {
      min-width: 0;
    }
  }
</style>
