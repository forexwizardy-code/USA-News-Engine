---
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { formatDateTime, formatDateTimeTZ, iso } from '../../lib/articles';

/**
 * Hidden preview route for NWS article drafts.
 *
 * This route is NOT linked anywhere on the public site. It is only accessible
 * when someone knows the exact URL. It renders a private draft using the real
 * production article design so editors can review the article + image before
 * publication.
 *
 * Constraints:
 *   - NOT in the content collection (reads from data/drafts/)
 *   - NOT in the sitemap
 *   - noindex,nofollow,noarchive
 *   - NO NewsArticle structured data
 *   - Self-referencing canonical (preview URL only)
 *   - NOT linked from homepage, category pages, related stories, etc.
 */

interface DraftSection {
  heading: string | null;
  paragraphs: string[];
}

interface Draft {
  draftVersion: number;
  storyKey: string;
  sourceAlertIds: string[];
  status: string;
  title: string;
  description: string;
  slug: string;
  category: string;
  location: string;
  publishedAt: string;
  updatedAt: string;
  breaking: boolean;
  author: string;
  sourceName: string;
  sourceUrl: string;
  sourceOffice: string;
  hasUpdates: boolean;
  originalInstruction: string | null;
  seo: { title: string; description: string };
  image: {
    status: string;
    url: string | null;
    draftPath: string;
    alt: string;
    source: string;
    dataSource: string;
    license: string;
  };
  body: DraftSection[];
  heroImage?: {
    mode: string;
    relation: string;
    path: string;
    alt: string;
    caption: string;
    creator: string;
    license: string;
    licenseUrl: string;
    sourcePageUrl: string;
    originalDate: string;
    attributionRequired: boolean;
    attributionText: string;
  };
  secondaryImage?: {
    mode: string;
    relation: string;
    path: string;
    alt: string;
    caption: string;
    source: string;
    dataSource: string;
    geographicDataSource: string;
    attributionText: string;
  };
  weatherMetadata: {
    event: string;
    severity: string;
    certainty: string;
    urgency: string;
    effective: string;
    onset: string;
    expires: string;
    ends: string;
    affectedZones: string[];
    priority: string;
    storyScore: number;
    updateCount: number;
    firstEffectiveAt: string | null;
    latestEffectiveAt: string | null;
  };
}

export async function getStaticPaths() {
  // Only generate preview pages for drafts that actually exist.
  // This keeps the preview system reusable — drop a new draft JSON in
  // data/drafts/ and it gets a preview page on the next build.
  const { readdir } = await import('node:fs/promises');
  const draftsDir = join(process.cwd(), 'data', 'drafts');
  let files: string[] = [];
  try {
    files = await readdir(draftsDir);
  } catch {
    // No drafts directory — no preview pages.
    return [];
  }
  return files
    .filter((f) => f.endsWith('.json'))
    .map((f) => {
      const storyKey = f.replace(/\.json$/, '');
      return { params: { slug: storyKey }, props: { storyKey } };
    });
}

interface Props {
  storyKey: string;
}
const { storyKey } = Astro.props;

// Load the draft JSON.
const draftPath = join(process.cwd(), 'data', 'drafts', `${storyKey}.json`);
let draftRaw: string;
try {
  draftRaw = await readFile(draftPath, 'utf8');
} catch {
  return Astro.redirect('/404');
}
const draft: Draft = JSON.parse(draftRaw);

// Hero image — use the real licensed photo if the draft has heroImage metadata,
// otherwise fall back to the generic graphic.
const heroImage = draft.heroImage?.path || `/preview-images/${draft.slug}.png`;
const heroImageAlt = draft.heroImage?.alt || draft.image?.alt || '';
const heroImageCaption = draft.heroImage?.caption || '';
const heroAttribution = draft.heroImage?.attributionText || '';
const heroLicenseUrl = draft.heroImage?.licenseUrl || '';

// Secondary image — the NWS alert map (placed after "Areas affected")
const secondaryImage = draft.secondaryImage || null;

// Parse timestamps.
// publishedAt = when this website first publishes (for previews, = generatedAt).
// updatedAt = when this website last materially updated (null on first publish).
// Never allow updatedAt < publishedAt — if updatedAt is null, hide it entirely.
const publishedAt = new Date(draft.publishedAt);
const updatedAt = draft.updatedAt ? new Date(draft.updatedAt) : null;
const effectiveDate = new Date(draft.weatherMetadata.effective);
const endsDate = new Date(draft.weatherMetadata.ends);

// Derive a safe U.S. timezone from the NWS office context.
// "NWS Chicago IL" → America/Chicago (Central). Only use when safely derivable.
const nwsOffice = draft.sourceOffice || '';
let displayTimezone: string | null = null;
if (/NWS Chicago/i.test(nwsOffice)) displayTimezone = 'America/Chicago';
// Add more office→timezone mappings as future stories require them.

// Format publication time for readers using the safe timezone when available.
const publishedDisplay = displayTimezone
  ? formatDateTimeTZ(publishedAt, displayTimezone)
  : formatDateTime(publishedAt);
const updatedDisplay = updatedAt && displayTimezone
  ? formatDateTimeTZ(updatedAt, displayTimezone)
  : updatedAt ? formatDateTime(updatedAt) : null;

// Build the preview path (self-referencing canonical).
const previewPath = `/preview/${storyKey}/`;

// Breadcrumbs — preview only, no link to a public article.
const breadcrumbs = [
  { name: 'Preview' },
  { name: draft.title },
];
---

<PreviewLayout
  title={draft.title}
  description={draft.description}
  previewPath={previewPath}
  ogImage={heroImage}
  publishedTime={publishedAt}
  modifiedTime={updatedAt}
  author={draft.author}
  section="Weather"
>
  <article class="article">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="article-head">
        <span class="cat-badge cat-badge--solid">Weather</span>
        <h1 class="article-title">{draft.title}</h1>
        <p class="article-dek">{draft.description}</p>

        <div class="article-meta">
          <div class="meta-block meta-byline">
            <span class="meta-label">By</span>
            <span class="meta-author">{draft.author}</span>
          </div>
          <div class="meta-dates">
            <div class="meta-block">
              <span class="meta-label">Published</span>
              <time class="meta-value" datetime={iso(publishedAt)}>
                {publishedDisplay}
              </time>
            </div>
            {
              updatedDisplay && updatedAt && updatedAt.getTime() > publishedAt.getTime() && (
                <div class="meta-block">
                  <span class="meta-label">Updated</span>
                  <time class="meta-value" datetime={iso(updatedAt)}>
                    {updatedDisplay}
                  </time>
                </div>
              )
            }
          </div>
        </div>
      </header>

      <figure class="article-figure">
        <img
          src={heroImage}
          alt={heroImageAlt}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <span class="figcaption-text">{heroImageCaption}</span>
          {heroAttribution && (
            <span class="figcaption-attribution">
              {heroLicenseUrl ? (
                <a href={heroLicenseUrl} rel="nofollow noopener" target="_blank">{heroAttribution}</a>
              ) : (
                heroAttribution
              )}
            </span>
          )}
        </figcaption>
      </figure>

      <div class="article-columns">
        <div class="article-content">
          <div class="article-body">
            {draft.body.map((section, i) => (
              <>
                <div class="draft-section">
                  {section.heading && <h2>{section.heading}</h2>}
                  {section.paragraphs.map((p) => (
                    <p set:html={p}></p>
                  ))}
                </div>
                {secondaryImage && section.heading === 'Areas affected' && (
                  <div class="secondary-visual">
                    <h3 class="secondary-heading">Flood Warning area</h3>
                    <figure class="secondary-figure">
                      <img
                        src={secondaryImage.path}
                        alt={secondaryImage.alt}
                        width="1200"
                        height="675"
                        loading="lazy"
                      />
                      <figcaption>
                        <span class="figcaption-text">{secondaryImage.caption}</span>
                        <span class="figcaption-attribution">{secondaryImage.attributionText}</span>
                      </figcaption>
                    </figure>
                  </div>
                )}
              </>
            ))}
          </div>

          <!-- Source attribution box (clean, reader-facing) -->
          <div class="article-source">
            <p class="source-label">Source</p>
            <div class="source-grid">
              <div class="source-row">
                <span class="source-key">Organization</span>
                <span class="source-val">{draft.sourceName}</span>
              </div>
              <div class="source-row">
                <span class="source-key">Office</span>
                <span class="source-val">{draft.sourceOffice}</span>
              </div>
              <div class="source-row">
                <span class="source-key">Original alert</span>
                <a
                  class="source-link"
                  href={draft.sourceUrl}
                  rel="nofollow noopener"
                  target="_blank"
                >
                  View official NWS alert &rarr;
                </a>
              </div>
            </div>
            <p class="source-note">
              This article was produced from official National Weather Service alert data. US News Engine is not the original source of this alert.
            </p>
          </div>
        </div>

        <aside class="article-aside" aria-label="Article details">
          <div class="aside-card">
            <p class="aside-title">Story details</p>
            <dl class="aside-list">
              <div>
                <dt>Category</dt>
                <dd>Weather</dd>
              </div>
              <div>
                <dt>Location</dt>
                <dd>{draft.location}</dd>
              </div>
              <div>
                <dt>Author</dt>
                <dd>{draft.author}</dd>
              </div>
              <div>
                <dt>Published</dt>
                <dd>{publishedDisplay}</dd>
              </div>
              <div>
                <dt>Updated</dt>
                <dd>{updatedDisplay || 'Not yet updated'}</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </article>
</PreviewLayout>

<style>
  .article {
    padding-bottom: 8px;
  }
  .article-head {
    max-width: 820px;
    margin: 8px auto 24px;
  }
  .article-title {
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 1.08;
    margin: 16px 0 14px;
  }
  .article-dek {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .meta-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .meta-author {
    font-weight: 700;
    color: var(--color-text);
  }
  .meta-value {
    font-size: 0.92rem;
    color: var(--color-text);
  }

  .cat-badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 2px;
    line-height: 1;
  }
  .cat-badge--solid {
    background: var(--color-red);
    color: #fff;
  }

  .article-figure {
    margin: 8px 0 32px;
  }
  .article-figure img {
    width: 100%;
    border-radius: var(--radius);
  }
  .article-figure figcaption {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 8px;
    padding-left: 12px;
    border-left: 3px solid var(--color-border-strong);
  }
  .figcaption-text {
    display: block;
  }
  .figcaption-attribution {
    display: block;
    margin-top: 3px;
    color: var(--color-text-soft);
    font-style: italic;
  }
  .figcaption-attribution a {
    color: var(--color-text-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .figcaption-attribution a:hover {
    color: var(--color-red);
  }
  .figcaption-source {
    color: var(--color-text-soft);
    font-style: italic;
  }

  /* Secondary map figure (inline in article body) */
  .secondary-visual {
    margin: 28px 0;
  }
  .secondary-heading {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--color-text);
  }
  .secondary-figure {
    padding: 16px;
    background: var(--color-surface-alt);
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }
  .secondary-figure img {
    width: 100%;
    border-radius: var(--radius);
  }
  .secondary-figure figcaption {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 8px;
    padding-left: 12px;
    border-left: 3px solid var(--color-border-strong);
  }
  .secondary-figure .figcaption-attribution {
    color: var(--color-text-soft);
  }

  .article-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }
  .article-content {
    max-width: 720px;
  }

  .article-body {
    font-size: 1.075rem;
    line-height: 1.75;
    color: #23262b;
  }
  .article-body > * + * {
    margin-top: 1.25rem;
  }
  .article-body h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
  }
  .article-body p {
    margin-top: 1.15rem;
  }
  .draft-section {
    margin-top: 1.5rem;
  }
  .draft-section:first-child {
    margin-top: 0;
  }

  /* Source box */
  .article-source {
    margin-top: 36px;
    padding: 24px;
    background: var(--color-surface-alt);
    border-left: 4px solid var(--color-red);
    border-radius: var(--radius);
  }
  .source-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }
  .source-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .source-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .source-key {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-muted);
    min-width: 110px;
    flex-shrink: 0;
  }
  .source-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .source-link {
    font-size: 0.9rem;
    color: var(--color-red-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .source-link:hover {
    color: var(--color-red);
  }
  .source-note {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
    color: var(--color-text-soft);
    font-style: italic;
  }

  /* Aside */
  .aside-card {
    position: sticky;
    top: 72px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-red);
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-text);
    margin-bottom: 14px;
  }
  .aside-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .aside-list dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .aside-list dd {
    font-size: 0.92rem;
    margin-top: 2px;
  }

  @media (max-width: 860px) {
    .article-columns {
      grid-template-columns: 1fr;
    }
    .aside-card {
      position: static;
    }
  }
  @media (max-width: 620px) {
    .article-meta {
      gap: 10px;
      flex-direction: column;
      align-items: flex-start;
    }
    .meta-byline {
      width: 100%;
    }
    .meta-dates {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 20px;
      width: 100%;
    }
    .meta-dates .meta-block {
      flex-direction: row;
      align-items: baseline;
      gap: 6px;
    }
    .meta-dates .meta-label {
      font-size: 0.62rem;
    }
    .meta-dates .meta-value {
      font-size: 0.85rem;
    }
    .source-row {
      flex-direction: column;
      gap: 2px;
    }
    .source-key {
      min-width: 0;
    }
  }
</style>
