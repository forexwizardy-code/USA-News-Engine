---
import { readFile, readdir } from 'node:fs/promises';
import { join } from 'node:path';
import PreviewLayout from '../../../layouts/PreviewLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CategoryBadge from '../../../components/CategoryBadge.astro';
import { iso } from '../../../lib/articles';

/**
 * Phase 10A.2 — Hidden preview route for General U.S. News drafts.
 *
 * NOT linked anywhere on the public site. Accessible only via the exact URL.
 * Renders a private General News draft for editorial review.
 *
 * Requirements (spec §20-21):
 *   - noindex,nofollow,noarchive (via PreviewLayout)
 *   - NOT in sitemap (excluded by /preview/ filter)
 *   - NOT on homepage / Latest / category listings
 *   - NO NewsArticle schema (handled by PreviewLayout)
 *   - Includes: headline, deck, hero image/graphic, byline, website
 *     preview-generated time, source publication time(s), article body,
 *     primary source box, additional source links, private claim audit,
 *     category, cluster information, image provenance.
 */

interface DraftSection {
  heading: string | null;
  paragraphs: string[];
}

interface ClaimAuditEntry {
  claim: string;
  source: string;
  sourceUrl: string;
  sourceType: string;
  publishedAtSource: string;
  supportingExcerpt: string;
}

interface Draft {
  generatedAt: string;
  generalStoryKey: string;
  slug: string;
  title: string;
  description: string;
  category: string;
  author: string;
  body: DraftSection[];
  primarySource: { name: string; type: string; url: string };
  supportingSources: { sourceName: string; sourceUrl: string; sourceType: string }[];
  allSourceUrls: string[];
  sourceCount: number;
  independentSourceCount: number;
  hasGovernmentSource: boolean;
  sourcePublishedAt: string;
  storyScore: number;
  freshnessStatus: string;
  freshnessLabel: string;
  sourceAgeHours: number;
  claimAudit: {
    auditType: string;
    note: string;
    generalStoryKey: string;
    claimCount: number;
    claims: ClaimAuditEntry[];
  };
  image: {
    mode: string;
    alt: string;
    caption: string;
    credit: string;
    sourcePageUrl: string;
  };
}

export async function getStaticPaths() {
  const draftsDir = join(process.cwd(), 'data', 'general-news', 'drafts');
  let files: string[] = [];
  try {
    files = await readdir(draftsDir);
  } catch {
    return [];
  }
  const paths = [];
  for (const f of files) {
    if (!f.endsWith('.json')) continue;
    try {
      const draft: Draft = JSON.parse(await readFile(join(draftsDir, f), 'utf8'));
      if (draft.slug) {
        paths.push({ params: { slug: draft.slug }, props: { draft } });
      }
    } catch {
      // skip malformed
    }
  }
  return paths;
}

interface Props {
  draft: Draft;
}
const { draft } = Astro.props;
const d = draft;

const previewPath = `/preview/general/${d.slug}/`;
const breadcrumbs = [
  { name: 'Preview', path: '/preview/' },
  { name: d.title },
];

const generatedDisplay = new Date(d.generatedAt).toLocaleString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
  hour: 'numeric', minute: '2-digit', hour12: true,
  timeZone: 'America/New_York', timeZoneName: 'short',
});
const sourcePubDisplay = d.sourcePublishedAt
  ? new Date(d.sourcePublishedAt).toLocaleString('en-US', {
      month: 'long', day: 'numeric', year: 'numeric',
      hour: 'numeric', minute: '2-digit', hour12: true,
      timeZone: 'America/New_York', timeZoneName: 'short',
    })
  : null;

const categoryLabel: Record<string, string> = {
  us: 'U.S.', politics: 'Politics', business: 'Business',
  technology: 'Technology', entertainment: 'Entertainment', sports: 'Sports',
};
const catLabel = categoryLabel[d.category] || d.category;
---

<PreviewLayout
  title={d.title}
  description={d.description}
  previewPath={previewPath}
  author={d.author}
  section={catLabel}
>
  <div class="container preview-general">
    <Breadcrumbs items={breadcrumbs} />

    <article class="article">
      <header class="article-head">
        <div class="preview-cat-row">
          <CategoryBadge category={d.category} href={`/${d.category}/`} variant="solid" />
          <span class="preview-cat-label">{catLabel} News</span>
          <span class="preview-freshness">Freshness: {d.freshnessLabel}</span>
        </div>
        <h1>{d.title}</h1>
        <p class="article-dek">{d.description}</p>
        <div class="article-meta">
          <div class="meta-block">
            <span class="meta-label">By</span>
            <span class="meta-author">{d.author}</span>
          </div>
          <div class="meta-block">
            <span class="meta-label">Preview generated</span>
            <time class="meta-value" datetime={iso(new Date(d.generatedAt))}>{generatedDisplay}</time>
          </div>
          {sourcePubDisplay && (
            <div class="meta-block">
              <span class="meta-label">Source published</span>
              <time class="meta-value" datetime={iso(new Date(d.sourcePublishedAt))}>{sourcePubDisplay}</time>
            </div>
          )}
          <div class="meta-block">
            <span class="meta-label">Story score</span>
            <span class="meta-value">{d.storyScore}/100</span>
          </div>
          <div class="meta-block">
            <span class="meta-label">Sources</span>
            <span class="meta-value">{d.sourceCount} ({d.independentSourceCount} independent){d.hasGovernmentSource ? ' · gov' : ''}</span>
          </div>
        </div>
      </header>

      <figure class="article-figure">
        <div class="graphic-fallback" aria-hidden="true">
          <span class="graphic-cat">{catLabel}</span>
          <span class="graphic-title">{d.title}</span>
          <span class="graphic-credit">{d.image.credit}</span>
        </div>
        <figcaption>
          <span class="figcaption-text">{d.image.caption}</span>
          <span class="figcaption-attribution">Graphic: {d.image.credit}</span>
        </figcaption>
      </figure>

      <div class="article-body">
        {d.body.map((section) => (
          <section>
            {section.heading && <h2>{section.heading}</h2>}
            {section.paragraphs.map((p) => <p set:html={p}></p>)}
          </section>
        ))}
      </div>

      <div class="article-source">
        <p class="source-label">Source</p>
        <div class="source-grid">
          <div class="source-row">
            <span class="source-key">Primary source</span>
            <span class="source-val">{d.primarySource.name}</span>
            <a class="source-link" href={d.primarySource.url} rel="nofollow noopener" target="_blank">
              View official {d.primarySource.type === 'government' ? 'release' : 'report'} &rarr;
            </a>
          </div>
          {d.supportingSources.length > 0 && (
            <div class="source-row source-row--additional">
              <span class="source-key">Additional reporting</span>
              <div class="source-additional">
                {d.supportingSources.map((s) => (
                  <div class="source-additional-item">
                    <span class="source-val">{s.sourceName}</span>
                    <a class="source-link" href={s.sourceUrl} rel="nofollow noopener" target="_blank">View original report &rarr;</a>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
        <p class="source-note">
          This article was produced from the cited publicly accessible source(s). US News Engine is not the original source and did not report from the scene. Original summaries are written from the cited evidence; refer to the linked sources for the full coverage.
        </p>
      </div>

      <div class="article-cluster">
        <p class="source-label">Cluster information</p>
        <dl class="cluster-list">
          <div><dt>Story key</dt><dd><code>{d.generalStoryKey}</code></dd></div>
          <div><dt>Category</dt><dd>{catLabel}</dd></div>
          <div><dt>Total sources</dt><dd>{d.sourceCount}</dd></div>
          <div><dt>Independent sources</dt><dd>{d.independentSourceCount}</dd></div>
          <div><dt>Government source</dt><dd>{d.hasGovernmentSource ? 'Yes' : 'No'}</dd></div>
          <div><dt>Source age</dt><dd>{d.sourceAgeHours} hours</dd></div>
          <div><dt>Freshness</dt><dd>{d.freshnessLabel}</dd></div>
        </dl>
      </div>

      <div class="claim-audit">
        <p class="source-label">Private claim audit — editorial review only</p>
        <p class="audit-note">{d.claimAudit.note}</p>
        <ol class="audit-list">
          {d.claimAudit.claims.map((c) => (
            <li>
              <p class="audit-claim">"{c.claim}"</p>
              <dl class="audit-meta">
                <div><dt>Source</dt><dd>{c.source} ({c.sourceType})</dd></div>
                <div><dt>URL</dt><dd><a href={c.sourceUrl} rel="nofollow noopener" target="_blank">{c.sourceUrl}</a></dd></div>
                {c.publishedAtSource && <div><dt>Published</dt><dd>{new Date(c.publishedAtSource).toLocaleString('en-US', {timeZone:'America/New_York', timeZoneName:'short'})}</dd></div>}
                <div><dt>Supporting excerpt</dt><dd>{c.supportingExcerpt}</dd></div>
              </dl>
            </li>
          ))}
        </ol>
      </div>

      <div class="image-provenance">
        <p class="source-label">Image provenance</p>
        <dl class="cluster-list">
          <div><dt>Mode</dt><dd>{d.image.mode}</dd></div>
          <div><dt>Credit</dt><dd>{d.image.credit}</dd></div>
          <div><dt>Source page</dt><dd><a href={d.image.sourcePageUrl} rel="nofollow noopener" target="_blank">{d.image.sourcePageUrl}</a></dd></div>
          <div><dt>Alt text</dt><dd>{d.image.alt}</dd></div>
        </dl>
      </div>
    </article>
  </div>
</PreviewLayout>

<style>
  .preview-general { max-width: 860px; margin: 0 auto; padding: 8px 0 64px; }
  .preview-cat-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .preview-cat-label { font-family: var(--font-sans); font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
  .preview-freshness { font-size: 0.78rem; color: var(--color-red); font-weight: 600; }
  .article-head h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.1; margin: 8px 0 14px; }
  .article-dek { font-family: var(--font-serif); font-size: 1.15rem; color: var(--color-text-muted); line-height: 1.5; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--color-border); }
  .meta-block { display: flex; flex-direction: column; gap: 2px; }
  .meta-label { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); }
  .meta-author { font-weight: 700; }
  .meta-value { font-size: 0.9rem; }

  .article-figure { margin: 24px 0; }
  .graphic-fallback {
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, #c8102e 0%, #7a0a1f 100%);
    color: #fff;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    gap: 8px; padding: 32px; text-align: center; border-radius: var(--radius);
  }
  .graphic-cat { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.9; }
  .graphic-title { font-family: var(--font-serif); font-size: 1.3rem; line-height: 1.3; max-width: 600px; }
  .graphic-credit { font-size: 0.74rem; opacity: 0.75; font-style: italic; }
  .article-figure figcaption { font-size: 0.82rem; color: var(--color-text-muted); margin-top: 8px; padding-left: 12px; border-left: 3px solid var(--color-border-strong); }
  .figcaption-text { display: block; }
  .figcaption-attribution { display: block; margin-top: 3px; font-style: italic; }

  .article-body { font-size: 1.05rem; line-height: 1.75; }
  .article-body h2 { font-size: 1.4rem; margin-top: 2rem; margin-bottom: 0.5rem; }
  .article-body p { margin-top: 1rem; }

  .article-source, .article-cluster, .claim-audit, .image-provenance {
    margin-top: 32px; padding: 24px; background: var(--color-surface-alt);
    border-left: 4px solid var(--color-red); border-radius: var(--radius);
  }
  .source-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 14px; }
  .source-grid { display: flex; flex-direction: column; gap: 12px; }
  .source-row { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .source-key { font-size: 0.82rem; font-weight: 700; color: var(--color-text-muted); min-width: 140px; }
  .source-val { font-weight: 600; }
  .source-link { font-size: 0.88rem; color: var(--color-red-dark); text-decoration: underline; }
  .source-row--additional { flex-direction: column; align-items: flex-start; }
  .source-additional { display: flex; flex-direction: column; gap: 8px; }
  .source-additional-item { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .source-note { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--color-border); font-size: 0.82rem; color: var(--color-text-soft); font-style: italic; }

  .cluster-list, .audit-meta { display: flex; flex-direction: column; gap: 10px; }
  .cluster-list dt, .audit-meta dt { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); }
  .cluster-list dd, .audit-meta dd { font-size: 0.92rem; margin-top: 2px; }
  .cluster-list code { font-size: 0.82rem; background: var(--color-surface); padding: 2px 6px; border-radius: 3px; }

  .audit-note { font-size: 0.82rem; color: var(--color-red); font-style: italic; margin-bottom: 14px; }
  .audit-list { display: flex; flex-direction: column; gap: 14px; padding-left: 1.2rem; }
  .audit-claim { font-weight: 600; font-style: italic; margin-bottom: 6px; }

  @media (max-width: 620px) {
    .article-meta { flex-direction: column; gap: 10px; }
    .source-row { flex-direction: column; align-items: flex-start; }
    .source-key { min-width: 0; }
  }
</style>
