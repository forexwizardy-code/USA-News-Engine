---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getAllArticles, getRelated, formatDateTime, formatDateTimeTZ, iso, getPublishedRegistry, findPublishedStory, isArchivedStory, type Article } from '../../lib/articles';
import { categoryLabel } from '../../consts';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}
const { article } = Astro.props;
const a = article.data;
const { Content } = await render(article);

// --- Related stories: prefer same-category, then fallback ---
// For recall articles, prefer other recall stories. For weather, prefer
// weather stories. Only use cross-category stories if no same-category
// stories are available.
import { getByCategory, getAllArticles as _getAllArticles } from '../../lib/articles';
const sameCategoryArticles = await getByCategory(a.category);
const sameCategoryRelated = sameCategoryArticles
  .filter((r) => r.data.slug !== a.slug)
  .slice(0, 3);
const related = sameCategoryRelated.length > 0
  ? sameCategoryRelated
  : await getRelated(article, 3);
const relatedLabel = sameCategoryRelated.length > 0 ? 'Related Stories' : 'Latest Stories';

// --- Lifecycle status from the published-stories registry ---
const registry = await getPublishedRegistry();
const publishedStory = findPublishedStory(registry, a.slug);
const lifecycleStatus = publishedStory?.lifecycleStatus;
const isArchived = isArchivedStory(lifecycleStatus);

const categoryHref = `/${a.category}/`;
const breadcrumbs = [
  { name: categoryLabel(a.category), path: categoryHref },
  { name: a.title, path: `/news/${a.slug}/` },
];

// --- Timestamp logic ---
// publishedAt = when this website first published.
// updatedAt = when this website last materially updated (undefined on first publish).
// Never show Updated when updatedAt is missing or <= publishedAt.
const publishedAt = a.publishedAt;
const updatedAt = a.updatedAt;
const hasRealUpdate = updatedAt && updatedAt.getTime() > publishedAt.getTime();

// --- Safe timezone derivation ---
// For Weather: derive from NWS source office location.
// For Recalls and other categories: use America/New_York as the site-wide
// editorial timezone (consistent U.S. East Coast publication time).
const office = a.sourceOffice || '';
let displayTimezone: string | null = null;
if (a.category === 'weather') {
  if (/NWS Chicago/i.test(office)) displayTimezone = 'America/Chicago';
  else if (/NWS Boston|NWS Norton|NWS New York|NWS Philadelphia|NWS Washington/i.test(office)) displayTimezone = 'America/New_York';
  else if (/NWS Melbourne|NWS Miami|NWS Tampa|NWS Jacksonville|NWS Key West/i.test(office)) displayTimezone = 'America/New_York';
  else if (/NWS Honolulu/i.test(office)) displayTimezone = 'Pacific/Honolulu';
  else if (/NWS Wakefield|NWS Norfolk/i.test(office)) displayTimezone = 'America/New_York';
} else {
  // For recalls and other categories, use America/New_York as editorial default
  displayTimezone = 'America/New_York';
}

const publishedDisplay = displayTimezone
  ? formatDateTimeTZ(publishedAt, displayTimezone)
  : formatDateTime(publishedAt);
const updatedDisplay = hasRealUpdate && displayTimezone
  ? formatDateTimeTZ(updatedAt!, displayTimezone)
  : hasRealUpdate ? formatDateTime(updatedAt!) : null;

// --- Image mode for object-fit behavior ---
const imageMode = a.imageMode || 'fallback-graphic';
const isMapImage = ['map-data', 'agency-graphic', 'fallback-graphic'].includes(imageMode);

// --- Photo/image attribution ---
const hasPhotoAttribution = !!a.imageCreator;
const attributionText = a.imageMode === 'licensed-photo'
  ? (a.imageLicense ? `Photo: ${a.imageCreator} / ${a.imageLicense}` : `Photo: ${a.imageCreator}`)
  : a.imageMode === 'factual-graphic-fallback'
  ? `Graphic: ${a.imageCreator}`
  : `Credit: ${a.imageCreator}`;
---

<BaseLayout
  title={a.title}
  description={a.description}
  canonicalPath={`/news/${a.slug}/`}
  ogImage={a.image}
  type="article"
  publishedTime={publishedAt}
  modifiedTime={hasRealUpdate ? updatedAt! : undefined}
  author={a.author}
  section={categoryLabel(a.category)}
  tags={a.tags}
  breadcrumbs={breadcrumbs}
>
  <article class="article">
    <div class="container">
      <Breadcrumbs items={breadcrumbs.slice(0, 1)} />

      {isArchived && lifecycleStatus === 'expired' && (
        <div class="lifecycle-notice lifecycle-notice--expired" role="status">
          <strong>This National Weather Service warning has expired.</strong>
          {publishedStory?.lastNwsEndsAt && (
            <span> The warning ended {formatDateTime(new Date(publishedStory.lastNwsEndsAt))}.</span>
          )}
          {' '}This article is preserved for reference.
        </div>
      )}
      {isArchived && lifecycleStatus === 'cancelled' && (
        <div class="lifecycle-notice lifecycle-notice--cancelled" role="status">
          <strong>The National Weather Service has cancelled this warning.</strong>
          {' '}This article is preserved for reference.
        </div>
      )}
      {isArchived && lifecycleStatus === 'superseded' && (
        <div class="lifecycle-notice lifecycle-notice--superseded" role="status">
          <strong>This warning has been superseded by a newer alert.</strong>
          {' '}This article is preserved for reference.
        </div>
      )}

      <header class="article-head">
        <CategoryBadge category={a.category} href={categoryHref} variant="solid" />
        <h1 class="article-title">{a.title}</h1>
        <p class="article-dek">{a.description}</p>

        <div class="article-meta">
          <div class="meta-block meta-byline">
            <span class="meta-label">By</span>
            <span class="meta-author">{a.author}</span>
          </div>
          <div class="meta-dates">
            <div class="meta-block">
              <span class="meta-label">Published</span>
              <time class="meta-value" datetime={iso(publishedAt)}>
                {publishedDisplay}
              </time>
            </div>
            {
              hasRealUpdate && updatedDisplay && (
                <div class="meta-block">
                  <span class="meta-label">Updated</span>
                  <time class="meta-value" datetime={iso(updatedAt!)}>
                    {updatedDisplay}
                  </time>
                </div>
              )
            }
          </div>
        </div>
      </header>

      <figure class="article-figure" class:list={[{ 'figure--map': isMapImage }]}>
        <img
          src={a.image}
          alt={a.imageAlt}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          {a.imageCaption && <span class="figcaption-text">{a.imageCaption}</span>}
          {hasPhotoAttribution && (
            <span class="figcaption-attribution">
              {a.imageLicenseUrl ? (
                <a href={a.imageLicenseUrl} rel="nofollow noopener" target="_blank">{attributionText}</a>
              ) : (
                attributionText
              )}
            </span>
          )}
        </figcaption>
      </figure>

      <div class="article-columns">
        <div class="article-content">
          <div class="article-body">
            <Content />
          </div>

          <!-- Tags -->
          {
            a.tags.length > 0 && (
              <div class="article-tags">
                <span class="tags-label">Tags:</span>
                <ul>
                  {a.tags.map((t) => (
                    <li>
                      <span class="tag">#{t}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <!-- Clean source attribution box -->
          <div class="article-source">
            <p class="source-label">Source</p>
            <div class="source-grid">
              <div class="source-row">
                <span class="source-key">Organization</span>
                <span class="source-val">{a.sourceName}</span>
              </div>
              {a.sourceOffice && (
                <div class="source-row">
                  <span class="source-key">Office</span>
                  <span class="source-val">{a.sourceOffice}</span>
                </div>
              )}
              <div class="source-row">
                <span class="source-key">{a.category === 'recalls' ? 'Original recall' : 'Original alert'}</span>
                <a
                  class="source-link"
                  href={a.sourceUrl}
                  rel="nofollow noopener"
                  target="_blank"
                >
                  {a.category === 'recalls' ? 'View official recall' : 'View official NWS alert'} &rarr;
                </a>
              </div>
            </div>
            <p class="source-note">
              {a.category === 'recalls'
                ? `This article was produced from ${a.sourceName === 'Consumer Product Safety Commission' ? 'an official recall notice from the U.S. Consumer Product Safety Commission' : 'official U.S. Food and Drug Administration recall data'}. US News Engine is not the original source of this recall.`
                : 'This article was produced from official National Weather Service alert data. US News Engine is not the original source of this alert.'}
            </p>
          </div>
        </div>

        <aside class="article-aside" aria-label="Article details">
          <div class="aside-card">
            <p class="aside-title">Story details</p>
            <dl class="aside-list">
              <div>
                <dt>Category</dt>
                <dd><a href={categoryHref}>{categoryLabel(a.category)}</a></dd>
              </div>
              {a.state && (
                <div>
                  <dt>Location</dt>
                  <dd>{a.state}</dd>
                </div>
              )}
              <div>
                <dt>Author</dt>
                <dd>{a.author}</dd>
              </div>
              <div>
                <dt>Published</dt>
                <dd>{publishedDisplay}</dd>
              </div>
              {hasRealUpdate && updatedDisplay && (
                <div>
                  <dt>Updated</dt>
                  <dd>{updatedDisplay}</dd>
                </div>
              )}
            </dl>
          </div>
        </aside>
      </div>
    </div>

    <!-- Related stories -->
    {
      related.length > 0 && (
        <section class="related" aria-label="Related stories">
          <div class="container">
            <SectionHeader title={relatedLabel} />
            <div class="related-grid">
              {related.map((r) => (
                <ArticleCard article={r} variant="default" />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .article {
    padding-bottom: 8px;
  }

  /* Lifecycle notices (expired, cancelled, superseded) */
  .lifecycle-notice {
    max-width: 820px;
    margin: 16px auto 24px;
    padding: 14px 20px;
    border-radius: var(--radius);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .lifecycle-notice--expired {
    background: #fff3e0;
    border-left: 4px solid #e65100;
    color: #5d2900;
  }
  .lifecycle-notice--cancelled {
    background: #e8f3ec;
    border-left: 4px solid #2e7d32;
    color: #1a4a28;
  }
  .lifecycle-notice--superseded {
    background: #e3f2fd;
    border-left: 4px solid #1565c0;
    color: #0d2c52;
  }

  .article-head {
    max-width: 820px;
    margin: 8px auto 24px;
  }
  .article-title {
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 1.08;
    margin: 16px 0 14px;
  }
  .article-dek {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .meta-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .meta-author {
    font-weight: 700;
    color: var(--color-text);
  }
  .meta-value {
    font-size: 0.92rem;
    color: var(--color-text);
  }

  .article-figure {
    margin: 8px 0 32px;
  }
  .article-figure img {
    width: 100%;
    border-radius: var(--radius);
  }
  /* Map graphics need contain to avoid cropping labels */
  .figure--map img {
    object-fit: contain;
    background: var(--color-surface-alt);
    aspect-ratio: 16 / 9;
  }
  .article-figure figcaption {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 8px;
    padding-left: 12px;
    border-left: 3px solid var(--color-border-strong);
  }
  .figcaption-text {
    display: block;
  }
  .figcaption-attribution {
    display: block;
    margin-top: 3px;
    color: var(--color-text-soft);
    font-style: italic;
  }
  .figcaption-attribution a {
    color: var(--color-text-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .figcaption-attribution a:hover {
    color: var(--color-red);
  }

  .article-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }
  .article-content {
    max-width: 720px;
  }

  .article-body {
    font-size: 1.075rem;
    line-height: 1.75;
    color: #23262b;
  }
  .article-body > * + * {
    margin-top: 1.25rem;
  }
  .article-body h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
  }
  .article-body p {
    margin-top: 1.15rem;
  }

  .article-tags {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .tags-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .article-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    display: inline-block;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.8rem;
    padding: 4px 10px;
    border-radius: 999px;
  }

  /* Source box */
  .article-source {
    margin-top: 36px;
    padding: 24px;
    background: var(--color-surface-alt);
    border-left: 4px solid var(--color-red);
    border-radius: var(--radius);
  }
  .source-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }
  .source-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .source-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .source-key {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-muted);
    min-width: 110px;
    flex-shrink: 0;
  }
  .source-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .source-link {
    font-size: 0.9rem;
    color: var(--color-red-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .source-link:hover {
    color: var(--color-red);
  }
  .source-note {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
    color: var(--color-text-soft);
    font-style: italic;
  }

  /* Aside */
  .aside-card {
    position: sticky;
    top: 72px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-red);
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-text);
    margin-bottom: 14px;
  }
  .aside-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .aside-list dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .aside-list dd {
    font-size: 0.92rem;
    margin-top: 2px;
  }
  .aside-list a {
    color: var(--color-red-dark);
  }

  /* Related */
  .related {
    margin-top: 56px;
    padding: 44px 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-alt);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 28px;
  }

  @media (max-width: 980px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    .article-columns {
      grid-template-columns: 1fr;
    }
    .aside-card {
      position: static;
    }
  }
  @media (max-width: 620px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
    .article-meta {
      gap: 10px;
      flex-direction: column;
      align-items: flex-start;
    }
    .meta-byline {
      width: 100%;
    }
    .meta-dates {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 20px;
      width: 100%;
    }
    .meta-dates .meta-block {
      flex-direction: row;
      align-items: baseline;
      gap: 6px;
    }
    .meta-dates .meta-label {
      font-size: 0.62rem;
    }
    .meta-dates .meta-value {
      font-size: 0.85rem;
    }
    .source-row {
      flex-direction: column;
      gap: 2px;
    }
    .source-key {
      min-width: 0;
    }
  }
</style>
