---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getAllArticles, getRelated, formatDateTime, iso, type Article } from '../../lib/articles';
import { categoryLabel } from '../../consts';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}
const { article } = Astro.props;
const a = article.data;
const { Content } = await render(article);

const related = await getRelated(article, 3);

const categoryHref = `/${a.category}/`;
const breadcrumbs = [
  { name: categoryLabel(a.category), path: categoryHref },
  { name: a.title, path: `/news/${a.slug}/` },
];
---

<BaseLayout
  title={a.title}
  description={a.description}
  canonicalPath={`/news/${a.slug}/`}
  ogImage={a.image}
  type="article"
  publishedTime={a.publishedAt}
  modifiedTime={a.updatedAt}
  author={a.author}
  section={categoryLabel(a.category)}
  tags={a.tags}
  breadcrumbs={breadcrumbs}
>
  <article class="article">
    <div class="container">
      <Breadcrumbs items={breadcrumbs.slice(0, 1)} />

      <header class="article-head">
        <CategoryBadge category={a.category} href={categoryHref} variant="solid" />
        <h1 class="article-title">{a.title}</h1>
        <p class="article-dek">{a.description}</p>

        <div class="article-meta">
          <div class="meta-block">
            <span class="meta-label">By</span>
            <span class="meta-author">{a.author}</span>
          </div>
          <div class="meta-block">
            <span class="meta-label">Published</span>
            <time class="meta-value" datetime={iso(a.publishedAt)}>
              {formatDateTime(a.publishedAt)}
            </time>
          </div>
          {
            a.updatedAt.getTime() !== a.publishedAt.getTime() && (
              <div class="meta-block">
                <span class="meta-label">Updated</span>
                <time class="meta-value" datetime={iso(a.updatedAt)}>
                  {formatDateTime(a.updatedAt)}
                </time>
              </div>
            )
          }
        </div>
      </header>

      <figure class="article-figure">
        <img
          src={a.image}
          alt={a.imageAlt}
          width="1200"
          height="675"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>{a.imageAlt}</figcaption>
      </figure>

      <div class="article-columns">
        <div class="article-content">
          <div class="article-body">
            <Content />
          </div>

          <!-- Tags -->
          {
            a.tags.length > 0 && (
              <div class="article-tags">
                <span class="tags-label">Tags:</span>
                <ul>
                  {a.tags.map((t) => (
                    <li>
                      <span class="tag">#{t}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <!-- Source attribution -->
          <div class="article-source">
            <p class="source-label">Source</p>
            <p class="source-name">{a.sourceName}</p>
            <a class="source-url" href={a.sourceUrl} rel="nofollow noopener" target="_blank">
              {a.sourceUrl}
            </a>
          </div>
        </div>

        <aside class="article-aside" aria-label="Article details">
          <div class="aside-card">
            <p class="aside-title">Story details</p>
            <dl class="aside-list">
              <div>
                <dt>Category</dt>
                <dd><a href={categoryHref}>{categoryLabel(a.category)}</a></dd>
              </div>
              {a.state && (
                <div>
                  <dt>Location</dt>
                  <dd>{a.state}</dd>
                </div>
              )}
              <div>
                <dt>Author</dt>
                <dd>{a.author}</dd>
              </div>
              <div>
                <dt>Published</dt>
                <dd>{formatDateTime(a.publishedAt)}</dd>
              </div>
              <div>
                <dt>Updated</dt>
                <dd>{formatDateTime(a.updatedAt)}</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>

    <!-- Related stories -->
    {
      related.length > 0 && (
        <section class="related" aria-label="Related stories">
          <div class="container">
            <SectionHeader title="Related Stories" />
            <div class="related-grid">
              {related.map((r) => (
                <ArticleCard article={r} variant="default" />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .article {
    padding-bottom: 8px;
  }
  .article-head {
    max-width: 820px;
    margin: 8px auto 24px;
  }
  .article-title {
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 1.08;
    margin: 16px 0 14px;
  }
  .article-dek {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .meta-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .meta-author {
    font-weight: 700;
    color: var(--color-text);
  }
  .meta-value {
    font-size: 0.92rem;
    color: var(--color-text);
  }

  .article-figure {
    margin: 8px 0 32px;
  }
  .article-figure img {
    width: 100%;
    border-radius: var(--radius);
  }
  .article-figure figcaption {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 8px;
    padding-left: 12px;
    border-left: 3px solid var(--color-border-strong);
  }

  .article-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }
  .article-content {
    max-width: 720px;
  }

  .article-tags {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .tags-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .article-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    display: inline-block;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.8rem;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .article-source {
    margin-top: 28px;
    padding: 18px 20px;
    background: var(--color-surface-alt);
    border-left: 4px solid var(--color-red);
    border-radius: var(--radius);
  }
  .source-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .source-name {
    font-weight: 700;
    margin-top: 4px;
  }
  .source-url {
    display: inline-block;
    margin-top: 4px;
    font-size: 0.85rem;
    color: var(--color-red-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-all;
  }

  /* Aside */
  .aside-card {
    position: sticky;
    top: 72px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .aside-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-red);
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-text);
    margin-bottom: 14px;
  }
  .aside-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .aside-list dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .aside-list dd {
    font-size: 0.92rem;
    margin-top: 2px;
  }
  .aside-list a {
    color: var(--color-red-dark);
  }

  /* Related */
  .related {
    margin-top: 56px;
    padding: 44px 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-alt);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 28px;
  }

  @media (max-width: 980px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    .article-columns {
      grid-template-columns: 1fr;
    }
    .aside-card {
      position: static;
    }
  }
  @media (max-width: 620px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
    .article-meta {
      gap: 18px;
    }
  }
</style>
