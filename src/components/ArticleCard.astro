---
import type { Article } from '../lib/articles';
import { relativeTime } from '../lib/articles';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  article: Article;
  variant?: 'hero' | 'default' | 'compact' | 'list';
  showImage?: boolean;
  showDescription?: boolean;
  rank?: number;
}
const {
  article,
  variant = 'default',
  showImage = true,
  showDescription = true,
  rank,
} = Astro.props;

const a = article.data;
const href = `/news/${a.slug}/`;
const hasImage = showImage && !!a.image;
// Map/graphics need object-fit: contain so labels aren't cropped.
// Photos use object-fit: cover for a visually filled card.
const imageMode = (a as any).imageMode || 'fallback-graphic';
const isMapImage = ['map-data', 'agency-graphic', 'fallback-graphic'].includes(imageMode);
---

{
  variant === 'hero' && (
    <article class="card card--hero">
      <a href={href} class:list={["card-media", { "card-media--map": isMapImage }]} tabindex="-1" aria-hidden="true">
        {hasImage ? (
          <img src={a.image} alt={a.imageAlt} loading="eager" width="1200" height="675" />
        ) : (
          <div class="card-media-fallback" />
        )}
        {a.breaking && <span class="card-flag card-flag--breaking">Breaking</span>}
      </a>
      <div class="card-body card-body--hero">
        <CategoryBadge category={a.category} href={`/${a.category}/`} variant="solid" />
        <h3 class="card-title card-title--hero">
          <a href={href}>{a.title}</a>
        </h3>
        {showDescription && <p class="card-dek">{a.description}</p>}
        <p class="byline">
          By <strong>{a.author}</strong> &middot;{' '}
          <time datetime={a.publishedAt.toISOString()}>{relativeTime(a.publishedAt)}</time>
        </p>
      </div>
    </article>
  )
}

{
  variant === 'default' && (
    <article class="card card--default">
      <a href={href} class:list={["card-media", { "card-media--map": isMapImage }]} tabindex="-1" aria-hidden="true">
        {hasImage ? (
          <img src={a.image} alt={a.imageAlt} loading="lazy" width="600" height="400" />
        ) : (
          <div class="card-media-fallback" />
        )}
      </a>
      <div class="card-body">
        <CategoryBadge category={a.category} href={`/${a.category}/`} variant="light" />
        <h3 class="card-title">
          <a href={href}>{a.title}</a>
        </h3>
        {showDescription && <p class="card-dek">{a.description}</p>}
        <p class="byline">
          By <strong>{a.author}</strong> &middot;{' '}
          <time datetime={a.publishedAt.toISOString()}>{relativeTime(a.publishedAt)}</time>
        </p>
      </div>
    </article>
  )
}

{
  variant === 'compact' && (
    <article class="card card--compact">
      <a href={href} class:list={["card-media", "card-media--small", { "card-media--map": isMapImage }]} tabindex="-1" aria-hidden="true">
        {hasImage ? (
          <img src={a.image} alt={a.imageAlt} loading="lazy" width="160" height="120" />
        ) : (
          <div class="card-media-fallback" />
        )}
      </a>
      <div class="card-body card-body--compact">
        <CategoryBadge category={a.category} href={`/${a.category}/`} variant="light" />
        <h4 class="card-title card-title--compact">
          <a href={href}>{a.title}</a>
        </h4>
        <p class="byline">
          <time datetime={a.publishedAt.toISOString()}>{relativeTime(a.publishedAt)}</time>
        </p>
      </div>
    </article>
  )
}

{
  variant === 'list' && (
    <article class="card card--list" class:list={{ ranked: typeof rank === 'number' }}>
      {typeof rank === 'number' && <span class="card-rank" aria-hidden="true">{rank}</span>}
      <div class="card-body card-body--list">
        <CategoryBadge category={a.category} href={`/${a.category}/`} variant="light" />
        <h4 class="card-title card-title--list">
          <a href={href}>{a.title}</a>
        </h4>
        <p class="byline">
          <time datetime={a.publishedAt.toISOString()}>{relativeTime(a.publishedAt)}</time>
        </p>
      </div>
    </article>
  )
}

<style>
  .card {
    background: var(--color-surface);
  }
  .card-media {
    display: block;
    overflow: hidden;
    background: var(--color-surface-alt);
    border-radius: var(--radius);
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  /* Map/graphics use contain so labels and boundaries aren't cropped */
  .card-media--map {
    background: var(--color-surface-alt, #f6f6f4);
  }
  .card-media--map img {
    object-fit: contain;
  }
  .card-media-fallback {
    width: 100%;
    aspect-ratio: 3 / 2;
    background: linear-gradient(135deg, #e9e7e1, #d8d5cd);
  }
  .card:hover .card-media img {
    transform: scale(1.04);
  }
  .card-title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .card-title a:hover {
    color: var(--color-red);
  }

  /* ---- Hero ---- */
  .card--hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 0;
    background: var(--color-surface);
  }
  .card--hero .card-media {
    border-radius: var(--radius);
    aspect-ratio: 16 / 10;
    position: relative;
  }
  .card-body--hero {
    padding: 8px 0 0 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
  }
  .card-title--hero {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }
  .card-title--hero a {
    line-height: 1.12;
  }
  .card-flag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--color-red);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 9px;
    border-radius: 2px;
  }

  /* ---- Default ---- */
  .card--default {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card--default .card-media {
    aspect-ratio: 3 / 2;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .card-title {
    font-size: 1.18rem;
    line-height: 1.22;
  }
  .card-dek {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ---- Compact ---- */
  .card--compact {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 14px;
    align-items: start;
  }
  .card-media--small {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
  }
  .card-body--compact {
    gap: 6px;
  }
  .card-title--compact {
    font-size: 1rem;
    line-height: 1.28;
  }

  /* ---- List (Most Read) ---- */
  .card--list {
    display: grid;
    grid-template-columns: 1fr;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .card--list.ranked {
    grid-template-columns: 44px 1fr;
    gap: 14px;
    align-items: start;
  }
  .card-rank {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-red);
  }
  .card-body--list {
    gap: 6px;
  }
  .card-title--list {
    font-size: 1.02rem;
    line-height: 1.3;
  }

  @media (max-width: 860px) {
    .card--hero {
      grid-template-columns: 1fr;
    }
    .card-body--hero {
      padding: 16px 0 0 0;
    }
    .card--compact {
      grid-template-columns: 100px 1fr;
    }
  }
</style>
