---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BreakingNews from '../components/BreakingNews.astro';
import type { Article } from '../lib/articles';

interface Props {
  title: string;
  description?: string;
  canonicalPath: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  section?: string;
  tags?: string[];
  breadcrumbs?: { name: string; path?: string }[];
  noindex?: boolean;
  breakingArticles?: Article[];
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  type,
  publishedTime,
  modifiedTime,
  author,
  section,
  tags,
  breadcrumbs,
  noindex,
  breakingArticles = [],
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      section={section}
      tags={tags}
      breadcrumbs={breadcrumbs}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header currentPath={currentPath} />
    {breakingArticles.length > 0 && <BreakingNews articles={breakingArticles} />}
    <main id="main" class="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Phase 10A.1 — reader-facing freshness layer (vanilla JS, no library).
      // Updates <time data-relative> elements with live relative timestamps
      // ("3 hr ago", "2 days ago") from the server-rendered datetime attribute.
      //
      // TIMEZONE POLICY: the header date is ALWAYS U.S. Eastern Time
      // (America/New_York), NOT the visitor's device timezone. A reader in
      // any non-U.S. timezone sees the same U.S. Eastern newsroom date.
      // Relative timestamps ("3 hr ago") are timezone-independent (they
      // compute the diff between now and the stored UTC timestamp) so no
      // timezone is needed for them.
      //
      // The server-rendered fallback (build-time ET date) remains for no-JS
      // users; this script progressively enhances it.
      (function () {
        function relativeTime(date) {
          var now = Date.now();
          var diff = now - date.getTime();
          var sec = Math.floor(diff / 1000);
          if (sec < 60) return 'just now';
          var min = Math.floor(sec / 60);
          if (min < 60) return min + ' min ago';
          var hr = Math.floor(min / 60);
          if (hr < 24) return hr + ' hr ago';
          var day = Math.floor(hr / 24);
          if (day === 1) return 'yesterday';
          if (day < 7) return day + ' days ago';
          var wk = Math.floor(day / 7);
          if (wk === 1) return '1 week ago';
          if (wk < 5) return wk + ' weeks ago';
          // For >5 weeks, show the ET date (not visitor's timezone).
          return date.toLocaleDateString('en-US', {
            month: 'short', day: 'numeric', year: 'numeric',
            timeZone: 'America/New_York'
          });
        }
        // Update all relative timestamps (timezone-independent).
        document.querySelectorAll('time[data-relative]').forEach(function (el) {
          var dt = el.getAttribute('datetime');
          if (!dt) return;
          var d = new Date(dt);
          if (isNaN(d.getTime())) return;
          el.textContent = relativeTime(d);
        });
        // Update header date to U.S. Eastern Time (NOT visitor's timezone).
        // A reader in any non-U.S. timezone sees the U.S. Eastern newsroom date.
        var hd = document.querySelector('[data-header-date]');
        if (hd) {
          hd.textContent = new Date().toLocaleDateString('en-US', {
            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
            timeZone: 'America/New_York'
          });
        }
      })();
    </script>
  </body>
</html>
